{
  "name": "miroex",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server that converts Miro boards into structured, machine-readable text for LLMs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkh-ai/miroex.git"
  },
  "keywords": [
    "miro",
    "mcp",
    "claude",
    "llm",
    "model-context-protocol",
    "board-reader",
    "spatial-clustering"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "render": "tsx src/render.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.3.1",
    "openai": "^6.22.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
